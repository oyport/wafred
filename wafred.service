# WAFred systemd service
# ─────────────────────────────────────────────────────────────────────────────
# Install to: /etc/systemd/system/wafred.service
# Enable:     sudo systemctl enable --now wafred
# Status:     sudo systemctl status wafred
# Logs:       sudo journalctl -u wafred -f
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=WAFred - High Performance Web Application Firewall
Documentation=https://github.com/oyport/wafred
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wafred
Group=wafred
ExecStart=/usr/local/bin/wafred all-in-one
# There is no reload signal: edit the configuration file (or the environment
# below) and restart the unit.
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=RUST_LOG=info,sqlx=warn
# Uncomment to read settings from a file — the environment above wins over it,
# and a command-line flag wins over both. The path must exist: a named
# configuration file that cannot be read stops the process at startup.
#Environment=WAFRED_CONFIG=/etc/wafred/wafred.toml

# The data plane binds 80/443 as the unprivileged wafred service user. Ambient
# capabilities survive NoNewPrivileges=true, unlike `setcap` on the binary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wafred /etc/wafred
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
